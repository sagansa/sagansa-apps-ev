APP_NAME=Sagansa
APP_ENV=local
APP_KEY=base64:44/QmhJeJ62ENaf9gahZoyEQwnRYRZo6bkfIBsX2oVg=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=ev
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ev
DB_USERNAME=root
DB_PASSWORD=root

# EV connection overrides (optional, defaulting to values above)
DB_EV_HOST=127.0.0.1
DB_EV_PORT=3306
DB_EV_DATABASE=ev
DB_EV_USERNAME=root
DB_EV_PASSWORD=root

DB_SAGANSA_CONNECTION=mysql
DB_SAGANSA_HOST=127.0.0.1
DB_SAGANSA_PORT=3306
DB_SAGANSA_DATABASE=sagansa
DB_SAGANSA_USERNAME=root
DB_SAGANSA_PASSWORD=root

DB_SAGANSA_USER_HOST=127.0.0.1
DB_SAGANSA_USER_PORT=3306
DB_SAGANSA_USER_DATABASE=sagansa_user
DB_SAGANSA_USER_USERNAME=root
DB_SAGANSA_USER_PASSWORD=root

DB_MIGRATIONS_CONNECTION=ev

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Maps API Key
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Google Analytics
GOOGLE_ANALYTICS_ID=G-5C30JTCW0S

# --- Social Sign-In (see docs/auth-google-apple-setup.md) ---
# Google: Web Client ID from Google Cloud Console (server-side verify audience).
GOOGLE_WEB_CLIENT_ID=
# Per-platform Google client IDs (accepted as alternative ID-token audiences).
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Apple Sign-In (server-side JWT verification). Native iOS (ASAuthorizationAppleIDProvider)
# mengirim token dengan aud = app bundle ID, jadi APPLE_BUNDLE_ID wajib diisi.
# APPLE_SERVICE_ID hanya untuk web flow (Sign in with Apple JS).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SERVICE_ID=
APPLE_BUNDLE_ID=id.sagansa.ev
APPLE_PRIVATE_KEY_PATH=
# App Store Server API — verifikasi transaksi langganan server-side (opsional).
# Bila kosong, backend memercayai klaim client dari StoreKit (mode dev).
APPLE_STORE_API_SANDBOX=true
# Google Play Developer API — verifikasi purchase Android (opsional).
GOOGLE_PLAY_PACKAGE_NAME=id.sagansa.ev
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# SPKLU serving: source kanonik yang disajikan GET /api/v1/spklu ('pln' | 'esdm')
SPKLU_SERVING_SOURCE=pln

# SPKLU coordinate codec — enkripsi koordinat agar tidak terbaca di network inspect
# Secret kunci (bump versi = ganti secret baru). Kosong = codec tidak aktif.
SPKLU_COORD_SECRET=
# Versi hash di dalam digest (bump = koordinat lama tidak bisa decode dgn kunci baru)
SPKLU_COORD_CODEC_VERSION=v1
# Enforce penuh setelah versi lama tidak signifikan. false = hanya untuk request ber-header.
SPKLU_COORD_CODEC_ENFORCE=false

# --- LM Studio (local LLM, OpenAI-compatible) ---
# Dipakai utk klasifikasi kandidat matching PLN↔ESDM yang ambiguous (stage 2).
# Setup: https://lmstudio.ai — load model (mis. qwen2.5-7b-instruct), server
# expose http://localhost:1234/v1. Bila mati/disabled → fallback geo+nama.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=local-model
LMSTUDIO_TIMEOUT=120
LMSTUDIO_ENABLED=true

# --- Google AdMob / AdSense Web ---
ADMOB_WEB_CLIENT_ID=ca-pub-3940256099942544
ADMOB_WEB_BANNER_SLOT=6300978111
ADMOB_ENABLED=true

# --- App Config (GET /api/v1/app/config — force update & build usage tracking) ---
# Build di bawah APP_MIN_VERSION_CODE ini wajib update (ForceUpdateScreen Android).
APP_MIN_VERSION_CODE=1
APP_LATEST_VERSION_NAME=
APP_UPDATE_MESSAGE=
APP_UPDATE_URL=
# Matikan saat production: false = klien tidak mengirim ping build usage.
APP_TRACK_BUILD_USAGE=true
# versionCode build Closed Testing yang sudah LIVE di Play Store (0 = belum ada).
# NAINKAN HANYA SETELAH release Closed Testing disetujui/live — Play Store harus
# benar-benar menyediakan build itu (versionCode lebih besar dari build IAS)
# supaya user yang diarahkan mendapat update, bukan jalur buntu/downgrade.
APP_LATEST_STORE_VERSION_CODE=0
# Minimum build number iOS (bundle version) yang boleh jalan. Default 0 = tidak
# pernah blokir. Terpisah dari Android supaya hotfix Android tak memblokir iOS.
APP_MIN_VERSION_CODE_IOS=0
# Tujuan tombol update iOS. Isi https://apps.apple.com/app/id<APPLE_ID> setelah
# app terbit di App Store; sementara kosong = tombol update disembunyikan
# (hanya pesan + Coba Lagi).
APP_UPDATE_URL_IOS=

# --- Admin Notification (tester registered email) ---
# Alamat email tujuan notifikasi saat ada tester baru (SMTP wajib aktif).
ADMIN_NOTIFY_EMAIL=
# Set false untuk menonaktifkan email notifikasi tanpa menghapus env.
ADMIN_NOTIFY_ENABLED=true


# OpenChargeMap API key (openchargemap.org — daftar gratis)
OCM_API_KEY=
